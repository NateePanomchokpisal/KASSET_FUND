# K Asset Morning Star
df1 = df.copy()
# Testing
# df1 = df[(df["fund_name"]=="K-US500X-A(A)")|(df["fund_name"]=="K-WPSPEEDUP")]
funds = df1["fund_name"]
asset_dict ={}
asset_val_dict = {}
fund_type_th = []
fund_type_en = []
for fund in funds:
    fund_url = f'https://www.kasikornasset.com/kasset/th/mutual-fund/fund-template/Pages/{fund}.aspx'
    browser.get(fund_url)
    sleep(1)
    # Close Cookie
    Submit_warning = browser.find_element(By.ID,"SubmitWarningTH")
    browser.execute_script("arguments[0].click();", Submit_warning)
    # Find the informations
    # Clicking information tab
    information_click = browser.find_element(By.CSS_SELECTOR,"a[aria-controls='information']")
    browser.execute_script("arguments[0].click();", information_click)
    # Expanding fund detail
    expanded_fund_detial = browser.find_element(By.CSS_SELECTOR,"button[aria-controls='panelsStayOpen-collapseThree']")
    browser.execute_script("arguments[0].click();", expanded_fund_detial)
    sleep(1)
    # type of fund
    fund_type = browser.find_element(By.CSS_SELECTOR,"ul.list-bullet").text.split("\n")
    fund_type_th.append(fund_type[0])
    fund_type_en.append(fund_type[1])
    # Detail of the fund
    # the top five assets 
    top_five_asset = browser.find_element(By.CSS_SELECTOR,"ul.list-unstyled.d-grid.gap-2")
    links = top_five_asset.find_elements(By.CSS_SELECTOR,"li.d-flex.gap-3")
    # top5columns = ["fund1","val1","fund2","val2","fund3","val3","fund4","val4","fund5","val5"]
    asset_list = []
    asset_val_list = []
    for num,link in enumerate(links):
        asset_val_list.append(link.find_element(By.CSS_SELECTOR,"strong.text-primary").text)
        asset_list.append(link.find_element(By.CSS_SELECTOR,"span").text)
    # adding to the empty dict
    asset_dict[fund] = asset_list
    asset_val_dict[fund] = asset_val_list
    
# Closing Browser
browser.close()
    
# Adding funding type (both TH and EN)
df1["fund_typeTH"] = fund_type_th.copy()
df1["fund_typeEN"] = fund_type_en.copy()
# Adjusting with the max of lenght for avoiding the un-matching same length
asset_df = pd.DataFrame(data = padding_none(*asset_dict.values()),index = asset_dict.keys(),columns = ["asset1","asset2","asset3","asset4","asset5"])
asset_val_df = pd.DataFrame(data = padding_none(*asset_val_dict.values()),index = asset_val_dict.keys(), columns = ["val1",'val2',"val3",'val4',"val5"])
# Joinning the data together
asset_df1 = asset_df.join(asset_val_df)

#Setting the index as Funding name for joinning together
df1.set_index("fund_name",inplace=True)

df2 = df1.join(asset_df1)
columns = ["fund_nav","fund_typeTH","fund_typeEN","asset1","val1","asset2","val2","asset3","val3","asset4","val4","asset5","val5"]
